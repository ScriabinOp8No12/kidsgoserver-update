:root {
    --ROCKETWIDTH: "min(20vw, 10rem)" % "";
    --ROCKETHEIGHT: calc(var(--ROCKETWIDTH) * 3);
}

#LandingPage {
    position: absolute;
    background-color: #001533;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-content: center;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;

    +portrait() {
        flex-direction: column;
    }

    .spacer {
        flex-grow: 0;
        flex-shrink: 1;
        +portrait() {
            height: "calc((100vh - 100vw) / 2)" % "";
        }
        +landscape() {
            width: "calc((100vw - 100vh) / 2)" % "";
        }
    }

    .mountain-background {
        flex-grow: 1;
        position: relative;
        text-align: center;
    }

    // Holds everything except the title animation so the whole scene can start
    // as a dark silhouette and gradually brighten while the title intro plays.
    .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url("/1.0/pages/home/background_no_planets_8_13_2026.svg");
        background-repeat: no-repeat;
    }

    .scene.intro-darkened {
        animation: intro-brighten 4s ease-out forwards;
    }

    // The blue side areas outside the scene square, dimmed in step with the
    // scene's brightness filter (#001533 at brightness 0.06 ~= #000103).
    &.intro-darkened {
        animation: intro-brighten-bg 4s ease-out forwards;
    }

    .stars-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 2;
    }

    .raccoon-animation {
        position: absolute;
        bottom: 8%;
        left: 50%;
        transform: translateX(-49%);
        width: 32%;
        pointer-events: none;
        z-index: 3;
    }

    // The foreground layers hold their own extra darkness after the scene
    // filter has started lifting, so the light reads as travelling from the
    // background forward. The raccoon and rockets share one curve so they
    // brighten at an identical rate. Multiplies with the .scene filter above.
    .scene.intro-darkened .raccoon-animation {
        animation: intro-brighten-foreground 4s ease-out forwards;
    }

    // Above the raccoon/stars but below the rockets, so a launching rocket
    // flies over the title/planets. During the intro the .scene filter makes
    // the scene a single layer, so the title still draws on top of it.
    .title-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: z.rocket - 1;
    }

    .scene.intro-darkened .learn-to-play-rocket,
    .scene.intro-darkened .play-rocket {
        animation: intro-brighten-foreground 4s ease-out forwards;
    }

    // A hovered rocket lifts above its neighbour so its popup -- which is now
    // a child, and so trapped in this rocket's stacking context -- can never
    // be overlapped by the other rocket.
    .learn-to-play-rocket:hover, .play-rocket:hover {
        z-index: z.rocket + 2;
    }

    .learn-to-play-rocket, .play-rocket {
        position: absolute;
        bottom: calc(var(--ROCKETHEIGHT) * 0.1 + 0.8rem);
        width: var(--ROCKETWIDTH);
        text-align: center;
        height: var(--ROCKETHEIGHT);
        z-index: z.rocket;
        cursor: pointer;

        .rocket-animation {
            position: absolute;
            top: 15%;
            left: 50%;
            width: 600%;
            height: 2500%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

    }

    // The popup is a child of its rocket, so its offsets are --ROCKETWIDTH
    // multiples and it stays pinned to the rocket at every aspect ratio.
    // Width still tracks the scene square (the old 39%, restated in viewport
    // units because a % here would resolve against the narrow rocket box), so
    // the bubble keeps growing on large displays as it always did. The video
    // is a square canvas with the bubble centred inside and only about half as
    // wide as the canvas, so the offsets are measured to the bubble, not the
    // canvas edge. The bubble sits inboard of its rocket, in the gap before
    // the raccoon, level with the mountain peaks.
    .rocket-popup {
        position: absolute;
        bottom: "calc(var(--ROCKETWIDTH) * 0.86)" % "";
        width: "calc(min(100vw, 100vh) * 0.39)" % "";
        aspect-ratio: 1;
        pointer-events: none;
        z-index: z.rocket + 1;
        // Stays mounted (so the video preloads) but hidden until hover.
        visibility: hidden;

        &.visible {
            visibility: visible;
        }
    }

    // Each popup leans inboard, into the gap between its rocket and the
    // raccoon, so it reads as belonging to that rocket without covering it.
    .learn-popup {
        left: 50%;
        transform: "translateX(calc(-50% + var(--ROCKETWIDTH) * 0.89))" % "";
    }

    .play-popup {
        right: 50%;
        transform: "translateX(calc(50% - var(--ROCKETWIDTH) * 0.83))" % "";
    }

    .learn-to-play-rocket {
        left: 5vw;
    }

    .play-rocket {
        right: 5vw;
    }
}

.cutscene-overlay {
    // Mounted but hidden during the launch animation so the video can buffer.
    &.preloading {
        display: none;
    }

    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    background-color: #000;
    overflow: hidden;
}

// The video and skip art are square; size each to the
// largest square that fits the viewport, centered, matching the home framing.
.cutscene-square {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: "min(100vw, 100vh)" % "";
    height: "min(100vw, 100vh)" % "";
    object-fit: contain;
}

.cutscene-video {
    opacity: 0;
    transition: opacity 0.35s ease;
}

.cutscene-video.visible {
    opacity: 1;
}

// Wraps the skip Lottie. The button art sits centered inside a large transparent
// canvas, so we shrink the canvas and tuck it into the bottom-right corner. The
// offsets are a share of the canvas itself (not the viewport) so the empty
// padding hangs off by the same amount at every aspect ratio -- percentage
// offsets against the full-screen overlay pushed the button clean off the
// bottom of tall phone viewports. --skip-size tracks the video square rather
// than the viewport for the same reason.
.cutscene-skip {
    --skip-size: "max(170px, min(42vw, 30vh))" % "";

    top: auto;
    left: auto;
    right: "calc(var(--skip-size) * -0.08)" % "";
    bottom: "calc(var(--skip-size) * -0.16)" % "";
    transform: none;
    width: var(--skip-size);
    height: var(--skip-size);
    z-index: 1001;
    cursor: pointer;

    .cutscene-square {
        top: 0;
        left: 0;
        transform: none;
        width: 100%;
        height: 100%;
    }
}

// Hold the scene as a dark silhouette while the title appears alone,
// then gradually brighten to full.
@keyframes intro-brighten {
    0% {
        filter: brightness(0.06);
    }
    25% {
        filter: brightness(0.06);
    }
    100% {
        filter: brightness(1);
    }
}

// Extra darkness held on top of the scene filter, shared by every foreground
// element. The background lifts first (see intro-brighten); the raccoon and
// rockets then lighten together on one identical curve, like a single light
// source reaching everything in front of it at the same moment and rate.
@keyframes intro-brighten-foreground {
    0% {
        filter: brightness(0.15);
    }
    40% {
        filter: brightness(0.15);
    }
    100% {
        filter: brightness(1);
    }
}

@keyframes intro-brighten-bg {
    0% {
        background-color: #000103;
    }
    25% {
        background-color: #000103;
    }
    100% {
        background-color: #001533;
    }
}
